                  <String fx:value="botao-menu" />
                  <String fx:value="titulo" />
               </styleClass>
               <graphic>
                  <FontIcon iconColor="#efffd6" iconLiteral="mdi2l-logout" iconSize="20" />
               </graphic>
            </Button>
         </children>
      </VBox>
   </left>
   <center>
      <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
            <Label alignment="CENTER" styleClass="texto-principal" text="Bem-Vindo(a)!" textFill="#4b793f">
               <font>
                  <Font name="Baskerville Old Face" size="20.0" />
               </font>
            </Label>
            <Label alignment="CENTER" layoutX="207.0" layoutY="223.0" text="Selecione uma opcao no menu ao lado." textFill="#4c7840aa">
               <font>
                  <Font name="Baskerville Old Face" size="13.0" />
               </font>
            </Label>
         </children></VBox>
   </center>
</BorderPane>
