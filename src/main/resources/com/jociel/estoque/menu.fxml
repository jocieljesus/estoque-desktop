<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane prefHeight="450.0" prefWidth="700.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jociel.estoque.MenuController">
   <left>
      <VBox prefHeight="450.0" prefWidth="189.0" styleClass="menu" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="titulo" text="Estoque 📦" textFill="WHITE">
               <font>
                  <Font name="Baskerville Old Face" size="20.0" />
               </font>
            </Label>
            <Button fx:id="btnSair" alignment="BASELINE_LEFT" mnemonicParsing="false" onAction="#aoSair" prefHeight="42.0" prefWidth="187.0" text=" Visualizar estoque">
               <styleClass>
                  <String fx:value="botao-menu" />
                  <String fx:value="titulo" />
               </styleClass>
               <graphic>
                  <FontIcon iconColor="#efffd6" iconLiteral="mdi2a-archive-eye-outline" iconSize="20" text="󱝖" />
               </graphic>
            </Button>
            <Button fx:id="btnSair1" alignment="BASELINE_LEFT" layoutX="18.0" layoutY="58.0" mnemonicParsing="false" onAction="#aoSair" prefHeight="38.0" prefWidth="175.0" text="Entrada de Produtos">
               <styleClass>
                  <String fx:value="botao-menu" />
                  <String fx:value="titulo" />
               </styleClass>
               <graphic>
                  <FontIcon iconColor="#efffd6" iconLiteral="mdi2p-package-variant-plus" iconSize="20" />
               </graphic>
            </Button>
            <Button fx:id="btnSair11" alignment="BASELINE_LEFT" layoutX="18.0" layoutY="96.0" mnemonicParsing="false" onAction="#aoSair" prefHeight="38.0" prefWidth="175.0" text="Relatório">
               <styleClass>
                  <String fx:value="botao-menu" />
                  <String fx:value="titulo" />
               </styleClass>
               <graphic>
                  <FontIcon iconColor="#efffd6" iconLiteral="mdi2b-beaker-check-outline" iconSize="20" />
               </graphic>
            </Button>
            <Button fx:id="btnSair1111" alignment="BASELINE_LEFT" layoutX="18.0" layoutY="172.0" mnemonicParsing="false" onAction="#aoSair" prefHeight="38.0" prefWidth="175.0" text="Sair">
