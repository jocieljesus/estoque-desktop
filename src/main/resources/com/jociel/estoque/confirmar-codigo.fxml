<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" spacing="12" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.jociel.estoque.controller.ConfirmarCodigoController">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Confirme o código" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Label fx:id="lblCodigoFicticio" style="-fx-text-fill: #555;"/>

    <TextField fx:id="txtCodigo" promptText="Código de 6 dígitos" maxWidth="200"/>
    <Label fx:id="lblMensagem" style="-fx-text-fill: red;"/>

    <Button text="Confirmar" onAction="#onConfirmar"/>
</VBox>
