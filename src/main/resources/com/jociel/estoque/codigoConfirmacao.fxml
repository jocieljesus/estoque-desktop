<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="300.0" prefWidth="400.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jociel.estoque.controller.CodigoConfirmacaoController">
   <children>
      <Label styleClass="titulo-recuperacao" text="Recuperação de Senha" />
      <Label fx:id="codigoRecuperacao" alignment="CENTER" layoutX="40.0" layoutY="94.0" prefHeight="26.0" prefWidth="141.0" styleClass="codigo-gerado" text="000000" textAlignment="CENTER" textFill="#efffd6" wrapText="true">
         <font>
            <Font size="16.0" />
         </font>
      </Label>
      <Label alignment="CENTER" layoutX="100.0" layoutY="127.0" prefHeight="27.0" prefWidth="340.0" styleClass="texto-email-recuperacao" text="Informe o código recebido." textAlignment="CENTER" wrapText="true">
         <font>
            <Font size="10.0" />
         </font>
      </Label>
      <TextField fx:id="codigoInformado" alignment="CENTER" onAction="#aoValidarCodigo" prefHeight="46.0" prefWidth="340.0" promptText="000000">
         <font>
            <Font size="18.0" />
         </font>
         <VBox.margin>
            <Insets left="120.0" right="120.0" />
         </VBox.margin></TextField>
      <Label fx:id="codigoInvalido" layoutX="100.0" layoutY="93.0" styleClass="texto-erro" text="Código inválido.Tente Novamente!" textFill="#c60303" visible="false">
         <VBox.margin>
            <Insets top="5.0" />
         </VBox.margin>
         <font>
            <Font name="System Italic" size="8.0" />
         </font>
      </Label>
      <Button mnemonicParsing="false" onAction="#aoValidarCodigo" prefHeight="41.0" prefWidth="140.0" styleClass="botao" text="Validar">
         <VBox.margin>
            <Insets top="20.0" />
         </VBox.margin>
      </Button>
   </children>
   <padding>
      <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
   </padding>
</VBox>
