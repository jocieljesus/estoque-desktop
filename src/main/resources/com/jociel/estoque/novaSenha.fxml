<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="300.0" prefWidth="400.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jociel.estoque.controller.NovaSenhaController">
   <children>
      <Label styleClass="titulo-recuperacao" text="Recuperação de Senha" />
      <PasswordField fx:id="novaSenha" prefHeight="37.0" prefWidth="340.0" promptText="Nova Senha">
         <font>
            <Font size="16.0" />
         </font>
         <VBox.margin>
            <Insets left="60.0" right="60.0" top="30.0" />
         </VBox.margin>
      </PasswordField>
      <PasswordField fx:id="confirmaSenha" layoutX="100.0" layoutY="119.0" onAction="#aoConfirmarSenha" prefHeight="37.0" prefWidth="340.0" promptText="Confirma Senha">
         <font>
            <Font size="16.0" />
         </font>
         <VBox.margin>
            <Insets left="60.0" right="60.0" top="20.0" />
         </VBox.margin>
      </PasswordField>
      <Label fx:id="senhasDiferentes" layoutX="100.0" layoutY="93.0" styleClass="texto-erro" text="As senhas não coincidem. Tente Novamente!" textFill="#c60303" visible="false">
         <VBox.margin>
            <Insets top="5.0" />
         </VBox.margin>
         <font>
            <Font name="System Italic" size="8.0" />
         </font>
      </Label>
      <Button mnemonicParsing="false" onAction="#aoConfirmarSenha" prefHeight="41.0" prefWidth="154.0" styleClass="botao" text="Cofirmar">
         <VBox.margin>
            <Insets top="20.0" />
         </VBox.margin>
         <font>
            <Font size="18.0" />
         </font>
      </Button>
   </children>
   <padding>
      <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
   </padding>
</VBox>
