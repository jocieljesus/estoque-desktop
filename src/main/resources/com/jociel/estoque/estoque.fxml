          <TableColumn prefWidth="257.33331298828125" text="Nome" />
            <TableColumn minWidth="0.0" prefWidth="158.66668701171875" text="Categoria" />
            <TableColumn minWidth="0.0" prefWidth="82.33334350585938" text="Quantidade" />
            <TableColumn minWidth="0.0" prefWidth="87.66668701171875" text="Preço (R$)" />
