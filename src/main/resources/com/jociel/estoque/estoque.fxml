<BorderPane prefHeight="450.0" prefWidth="700.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jociel.estoque.EstoqueController">
   <top>
      <VBox prefHeight="121.0" prefWidth="700.0" BorderPane.alignment="CENTER">
