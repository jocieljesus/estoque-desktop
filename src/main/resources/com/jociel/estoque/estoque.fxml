<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane prefHeight="450.0" prefWidth="700.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jociel.estoque.controller.EstoqueController">
   <top>
      <VBox prefHeight="121.0" prefWidth="700.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Estoque de Produtos">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <TextField fx:id="campoBusca" minHeight="32.0" prefHeight="25.0" prefWidth="270.0" styleClass="campos-login">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                     <font>
                        <Font size="14.0" />
                     </font>
                  </TextField>
                  <Button fx:id="btnAdicionar" minHeight="32.0" mnemonicParsing="false" onAction="#adicionarProduto" prefHeight="32.0" prefWidth="80.0" styleClass="btn-prod">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                     <graphic>
                        <FontIcon iconColor="WHITE" iconLiteral="mdi2l-layers-plus" iconSize="20" />
                     </graphic>
                  </Button>
                  <Button fx:id="btnEditar" layoutX="159.0" layoutY="10.0" minHeight="32.0" mnemonicParsing="false" onAction="#editarProduto" prefHeight="32.0" prefWidth="80.0" styleClass="btn-prod">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                     <graphic>
                        <FontIcon iconColor="WHITE" iconLiteral="mdi2p-pencil-box-multiple" iconSize="20" text="󱅄" />
                     </graphic>
                  </Button>
                  <Button fx:id="btnRemover" layoutX="221.0" layoutY="10.0" minHeight="32.0" mnemonicParsing="false" onAction="#removerProduto" prefHeight="32.0" prefWidth="80.0" styleClass="btn-remover">
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                     <graphic>
                        <FontIcon iconColor="WHITE" iconLiteral="mdi2t-trash-can" iconSize="20" />
                     </graphic>
                  </Button>
                  <Button fx:id="btnVoltar" layoutX="283.0" layoutY="10.0" minHeight="32.0" mnemonicParsing="false" onAction="#aoVoltarMenu" prefHeight="32.0" prefWidth="80.0" styleClass="btn-prod">
                     <graphic>
                        <FontIcon iconColor="WHITE" iconLiteral="mdi2k-keyboard-return" iconSize="20" text="󰌑" />
                     </graphic></Button>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="30.0" right="30.0" top="20.0" />
         </padding></VBox>
   </top>
   <center>
      <TableView fx:id="tabelaProdutos" prefHeight="200.0" prefWidth="200.0" styleClass="table" stylesheets="@style.css" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="colunaId" prefWidth="54.333335876464844" text="ID" />
          <TableColumn fx:id="colunaNome" prefWidth="257.33331298828125" text="Nome" />
            <TableColumn fx:id="colunaCategoria" minWidth="0.0" prefWidth="158.66668701171875" text="Categoria" />
            <TableColumn fx:id="colunaQuantidade" minWidth="0.0" prefWidth="82.33334350585938" text="Quantidade" />
            <TableColumn fx:id="colunaPreco" minWidth="0.0" prefWidth="87.66668701171875" text="Preço (R$)" />
        </columns>
         <BorderPane.margin>
            <Insets bottom="10.0" left="30.0" right="30.0" />
         </BorderPane.margin>
      </TableView>
   </center>
</BorderPane>
