<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="450.0" prefWidth="700.0" styleClass="texto-principal" stylesheets="@style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jociel.estoque.controller.ProdutoController">
   <top>
      <VBox prefHeight="77.0" prefWidth="700.0" styleClass="root" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="texto-principal" text="Dados do Produto">
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
         </children>
         <padding>
            <Insets bottom="10.0" left="80.0" right="80.0" top="30.0" />
         </padding></VBox>
   </top>
   <center>
      <VBox prefHeight="380.0" prefWidth="700.0" BorderPane.alignment="CENTER">
         <children>
            <VBox alignment="CENTER_LEFT" prefHeight="74.0" prefWidth="700.0">
               <children>
                  <Label styleClass="root" text="Nome">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <TextField prefHeight="35.0" prefWidth="540.0" />
               </children>
               <padding>
                  <Insets left="80.0" right="80.0" />
               </padding>
            </VBox>
            <VBox alignment="CENTER_LEFT" layoutX="10.0" layoutY="10.0" prefHeight="72.0" prefWidth="700.0">
               <children>
                  <Label styleClass="root" text="Categoria">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <TextField prefHeight="35.0" prefWidth="540.0" />
               </children>
               <padding>
                  <Insets left="80.0" right="80.0" />
               </padding>
            </VBox>
            <VBox alignment="CENTER_LEFT" layoutX="10.0" layoutY="75.0" prefHeight="75.0" prefWidth="700.0">
               <children>
                  <Label styleClass="root" text="Quantidade">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <TextField prefHeight="35.0" prefWidth="540.0" />
               </children>
               <padding>
                  <Insets left="80.0" right="80.0" />
               </padding>
            </VBox>
            <VBox alignment="CENTER_LEFT" layoutX="10.0" layoutY="140.0" prefWidth="700.0">
               <children>
                  <Label styleClass="root" text="Preço">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <TextField prefHeight="35.0" prefWidth="540.0" />
               </children>
               <padding>
                  <Insets left="80.0" right="80.0" />
               </padding>
            </VBox>
            <HBox alignment="CENTER_RIGHT" prefHeight="87.0" prefWidth="700.0">
               <padding>
                  <Insets left="80.0" right="80.0" />
               </padding>
               <children>
                  <Button mnemonicParsing="false" prefHeight="35.0" prefWidth="114.0" styleClass="botao" text="Cancelar" onAction="#cancelar">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <HBox.margin>
                        <Insets right="20.0" />
                     </HBox.margin>
                  </Button>
                  <Button layoutX="496.0" layoutY="26.0" mnemonicParsing="false" prefHeight="35.0" prefWidth="114.0" styleClass="botao" text="Salvar" onAction="#salvar">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>
