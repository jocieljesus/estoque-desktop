<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jociel.estoque.controller.ProdutoController">
    <top>
        <VBox BorderPane.alignment="CENTER" VBox.vgrow="ALWAYS">
            <children>
                <Label text="Dados do Produto">
                    <padding>
                        <Insets bottom="15.0" left="50.0" top="30.0" />
                    </padding>
                    <font>
                        <Font name="Segoe UI Semibold" size="20.0" />
                    </font>
                </Label>
            </children>
        </VBox>
    </top>
    <center>
        <VBox spacing="10" BorderPane.alignment="CENTER" VBox.vgrow="ALWAYS">
            <padding>
                <Insets left="80.0" right="80.0" top="10.0" />
            </padding>
            <children>
                <VBox VBox.vgrow="ALWAYS">
                    <children>
                        <Label text="Nome">
                            <font>
                                <Font name="Segoe UI Semibold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="campoNome" maxWidth="Infinity" prefHeight="38.0" VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>
                <VBox VBox.vgrow="ALWAYS">
                    <children>
                        <Label text="Categoria">
                            <font>
                                <Font name="Segoe UI Semibold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="campoCategoria" maxWidth="Infinity" prefHeight="34.0" VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>
                <VBox VBox.vgrow="ALWAYS">
                    <children>
                        <Label text="Quantidade">
                            <font>
                                <Font name="Segoe UI Semibold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="campoQuantidade" maxWidth="Infinity" prefHeight="34.0" />
                    </children>
                </VBox>
                <VBox VBox.vgrow="ALWAYS">
                    <children>
                        <Label text="Preço">
                            <font>
                                <Font name="Segoe UI Semibold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="campoPreco" maxWidth="Infinity" prefHeight="34.0" />
                    </children>
                </VBox>
                <HBox alignment="CENTER_RIGHT" prefHeight="48.0" prefWidth="540.0" spacing="15" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS">
                    <VBox.margin>
                        <Insets top="20.0" />
                    </VBox.margin>
                    <children>
                        <Button fx:id="botaoCancelar" onAction="#cancelar" prefHeight="42.0" prefWidth="117.0" text="Cancelar" HBox.hgrow="ALWAYS">
                            <font>
                                <Font name="Segoe UI Semibold Italic" size="12.0" />
                            </font>
                        </Button>
                        <Button fx:id="botaoSalvar" onAction="#salvar" prefHeight="42.0" prefWidth="117.0" style="-fx-background-color: #213A40;" text="Salvar" textFill="WHITE" HBox.hgrow="ALWAYS">
                            <font>
                                <Font name="Segoe UI Semibold" size="12.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
